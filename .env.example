# ==============================================================================
# TrustRAG Environment Configuration Template (.env.example)
# Copy this file to .env and configure local values.
# NEVER commit the actual .env file containing real secrets to version control.
# ==============================================================================

# Application Runtime Configuration
APP_NAME=TrustRAG
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# LLM Provider Configuration (Google AI Studio Free Tier)
# Signup URL: https://aistudio.google.com/
# Leave empty until Phase 5 when LLM integration is implemented.
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-flash

# Embedding & Vector Database Settings (Local First)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chromadb
CHROMA_COLLECTION_NAME=trustrag_documents

# Application Metadata & Audit Store (Local SQLite)
DATABASE_URL=sqlite:///./data/trustrag.db

# Trust & Reliability Thresholds (Provisional)
TRUST_THRESHOLD_HIGH=0.85
TRUST_THRESHOLD_LOW=0.50
RETRIEVAL_RELEVANCE_THRESHOLD=0.35
MAX_RETRIEVAL_RETRIES=1

# Human-in-the-Loop (HITL) Queue Settings
HITL_ENABLED=true

